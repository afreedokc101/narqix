---
import { getCollection } from 'astro:content';
import LessonPage from '../../../components/LessonPage.astro';
import { sections, sectionLessons, tracks } from '../../../lib/data';

export async function getStaticPaths() {
  const entries = await getCollection('lessons');
  return sections.map((s) => ({
    params: { section: s.key },
    props: { key: s.key, entry: entries.find((e) => e.data.section === s.key && e.data.page === 'overview') },
  }));
}
const { key, entry } = Astro.props;
const pages = sectionLessons(key).filter((l) => !l.isRoot);
const isScripts = key === 'scripts';
const groups = isScripts
  ? [{ key: '*', title: 'Core scripts (all tracks)' }, ...Object.values(tracks).map((t) => ({ key: t.key, title: t.title }))].map((g) => ({
      ...g,
      items: pages.filter((p) => p.scriptTrack === g.key),
    }))
  : [{ key, title: 'Pages in this section', items: pages }];
const isTrack = key in tracks;
---
{entry ? (
  <LessonPage entry={entry}>
    {isTrack && (
      <p class="mt-8"><a class="btn btn-primary" href={`/tracks/${key}/`}>See the full {tracks[key].title} learning path</a></p>
    )}
    {groups.map((g) => (
      <section class="mt-10" aria-label={g.title}>
        <h2 class="text-xl">{g.title}</h2>
        <ol class="mt-3 grid gap-2">
          {g.items.map((p) => (
            <li><a href={p.url} class="card px-4 py-3 block no-underline text-ink hover:border-accent">{p.title}{p.role && <span class="block text-xs text-muted mt-0.5">{p.role}</span>}</a></li>
          ))}
        </ol>
      </section>
    ))}
  </LessonPage>
) : null}
