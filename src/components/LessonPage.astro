---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { lessonById, sectionLessons, sectionTitle, tracks, tracksForLesson, trackList } from '../lib/data';

interface Props { entry: CollectionEntry<'lessons'> }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const meta = lessonById.get(d.id)!;
const siblings = sectionLessons(d.section);
const idx = siblings.findIndex((l) => l.id === d.id);
const prev = siblings[idx - 1];
const next = siblings[idx + 1];
const inTracks = tracksForLesson(d.id);
const isScripts = d.section === 'scripts';
const scriptTrackTitle = d.scriptTrack === '*' ? 'All tracks (core)' : d.scriptTrack ? tracks[d.scriptTrack]?.title : null;
---
<Base title={d.title} description={d.summary || undefined}>
  <article class="wrap-narrow py-8" data-lesson={d.id} data-tracks={inTracks.join(',')}>
    <nav class="text-sm text-muted" aria-label="Breadcrumb">
      <a href="/learn/" class="no-underline text-muted hover:text-ink">Learn</a>
      <span aria-hidden="true"> / </span>
      <a href={`/learn/${d.section}/`} class="no-underline text-muted hover:text-ink">{sectionTitle(d.section)}</a>
    </nav>
    <h1 class="mt-3 text-3xl sm:text-4xl">{d.title}</h1>
    <div class="mt-3 flex flex-wrap gap-2 text-xs">
      {d.duration && <span class="badge">{d.duration}</span>}
      {scriptTrackTitle && <span class="badge badge-accent">{scriptTrackTitle}</span>}
      {d.role && <span class="badge">{d.role}</span>}
      {d.stage && <span class="badge">{d.stage}</span>}
      {d.scriptId && <span class="badge">{d.scriptId}</span>}
    </div>

    <div class="progress-box card p-4 mt-6" hidden>
      <div class="flex items-center justify-between gap-3 text-sm">
        <span><span data-p="title"></span> track progress</span>
        <span class="text-muted" data-p="count"></span>
      </div>
      <div class="bar mt-2" role="progressbar" aria-label="Track progress" aria-valuemin="0" aria-valuemax="100"><span style="width:0%"></span></div>
    </div>

    <div class="prose mt-8">
      <Content />
    </div>

    <slot />

    <div class="mt-10 card p-4 flex flex-col sm:flex-row sm:items-center gap-3 justify-between">
      <p class="text-sm text-muted" data-read-hint>
        <a href="/signup/" class="underline">Sign up</a> or <a href="/login/" class="underline">log in</a> to track your progress.
      </p>
      <button type="button" class="btn btn-primary" data-read-btn hidden aria-pressed="false">Mark as read</button>
    </div>

    <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="Next and previous">
      {prev ? (
        <a href={prev.url} class="card p-4 no-underline text-ink hover:border-accent"><span class="block text-xs text-muted">Previous</span>{prev.title}</a>
      ) : <span></span>}
      {next && (
        <a href={next.url} class="card p-4 no-underline text-ink hover:border-accent sm:text-right"><span class="block text-xs text-muted">Next</span>{next.title}</a>
      )}
    </nav>
    {isScripts && !next && <p class="mt-6 text-sm text-muted">Your track page lists the scripts for your role: <a href="/learn/">see all tracks</a>.</p>}
  </article>
</Base>

<script>
  import { api, loggedIn } from '../scripts/client';

  const article = document.querySelector('[data-lesson]') as HTMLElement;
  const lessonId = article.dataset.lesson!;
  const inTracks = (article.dataset.tracks || '').split(',').filter(Boolean);
  const btn = document.querySelector('[data-read-btn]') as HTMLButtonElement;
  const hint = document.querySelector('[data-read-hint]') as HTMLElement;
  const box = document.querySelector('.progress-box') as HTMLElement;

  function setBtn(read: boolean) {
    btn.textContent = read ? 'Read ✓ (undo)' : 'Mark as read';
    btn.setAttribute('aria-pressed', String(read));
    btn.classList.toggle('btn-primary', !read);
    btn.classList.toggle('btn-ghost', read);
  }
  function setBar(p: { trackTitle: string; trackRead: number; trackTotal: number; track: string }) {
    if (!inTracks.includes(p.track)) return;
    box.hidden = false;
    const pct = p.trackTotal ? Math.round((p.trackRead / p.trackTotal) * 100) : 0;
    box.querySelector('[data-p="title"]')!.textContent = p.trackTitle;
    box.querySelector('[data-p="count"]')!.textContent = `${p.trackRead}/${p.trackTotal} · ${pct}%`;
    (box.querySelector('.bar > span') as HTMLElement).style.width = pct + '%';
    box.querySelector('.bar')!.setAttribute('aria-valuenow', String(pct));
  }

  async function load() {
    if (!loggedIn()) return;
    const r = await api('/api/progress');
    if (!r.ok) return;
    hint.textContent = 'Finished this page? Mark it as read to track your progress.';
    btn.hidden = false;
    let read = r.data.read.includes(lessonId);
    setBtn(read);
    setBar(r.data);
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      const res = await api('/api/progress', { lessonId, read: !read });
      btn.disabled = false;
      if (!res.ok) return;
      read = !read;
      setBtn(read);
      const p = await api('/api/progress');
      if (p.ok) setBar(p.data);
    });
  }
  load();
</script>
