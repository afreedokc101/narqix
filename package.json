{
  "name": "narqix-academy",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "import": "node scripts/import-notion.mjs",
    "fetch-logo": "node scripts/fetch-logo.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler pages dev dist --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply narqix-academy --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply narqix-academy --remote",
    "test": "node scripts/test-api.mjs",
    "check:leaks": "node scripts/check-no-answers.mjs",
    "deploy": "node scripts/predeploy.mjs && npm run build && wrangler pages deploy dist --project-name narqix-academy --branch main"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "jspdf": "^4.2.1",
    "tailwindcss": "^4.3.3",
    "worker-mailer": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "marked": "^14.1.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.154.0"
  }
}
